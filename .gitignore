# Nested clone of the book-to-skill fork, symlinked into ~/.claude/skills (not vendored here)
/book-to-skill
/skills/book-to-skill/
# Nested clone of deep-research-skills (not vendored here)
/skills/deep-research-skills/
# Personal health workflow with private lab data — local only, never publish
/skills/trt/
# Local planning notes (may name people/orgs) — never publish
/skills/*/Plans/
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/

# Skill-creator eval scratch trees — contain real transcripts with identity/employer data
/skills/*-workspace/
/skills/*/eval-workspace/

# Local identity denylist — real names must never be committed to this public repo
.identity-denylist

# One-shot local purge runbook — hardcodes a personal email and home path, never publish
/scripts/history-purge-runbook.sh
